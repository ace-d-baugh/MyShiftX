# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database Direct Connection (for migrations)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email Configuration (Supabase SMTP or custom)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@myshiftx.com

# Rate Limiting (Upstash Redis - optional)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Error Tracking (Sentry) — set NEXT_PUBLIC_SENTRY_DSN to turn it on; everything else
# stays a no-op until then (same env-flip pattern as AdSense/push/showcase mode).
# ORG/PROJECT/AUTH_TOKEN are only needed to upload source maps (readable stack traces
# in the Sentry dashboard) — get them from Settings > Auth Tokens on sentry.io.
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id

# Timezone (for server-side operations)
TZ=America/New_York

# Node Environment
NODE_ENV=development

# Cron Job Secret (generate a strong random string)
# Used to secure the /api/cron/* endpoints and to sign digest unsubscribe links
CRON_SECRET=your-cron-secret-here

# Registration gate — fail-closed: sign-ups are PAUSED unless this is set to 1.
# Set in .env.local and Vercel Preview (dev branch); leave unset on Production
# until launch, then add it there to reopen sign-ups with no code change.
NEXT_PUBLIC_REGISTRATION_OPEN=1

# Showcase mode — the temporary public, read-only face of the site, built so
# AdSense reviewers and Googlebot aren't stopped by the login wall.
# Set to 1 and:
#   - /wall, /calendar and /messages become public, served from fixtures and
#     labelled as an interactive demo (app/preview/*)
#   - /register and the account-recovery routes 404; /login still works but is
#     linked from nowhere
#   - every server action, write API route, and cron job refuses
# Unset it and everything returns to normal on the next deploy. The blog and
# FAQ stay live either way.
# See lib/showcase/mode.ts.
NEXT_PUBLIC_SHOWCASE_MODE=1

# Google AdSense (Task 12) — publisher ID + one env var per ad placement.
# A placement missing any piece below renders a house ad (a blog post promo)
# instead of a blank unit — see components/features/HouseAd.tsx.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT_STICKY_DESKTOP=your-sticky-desktop-slot-id-here
# 2 and 3 fill in a column of three on extra-wide (xl+) screens only — the
# desktop rail shows just the one above from lg up to xl.
NEXT_PUBLIC_ADSENSE_SLOT_STICKY_DESKTOP_2=your-sticky-desktop-slot-2-id-here
NEXT_PUBLIC_ADSENSE_SLOT_STICKY_DESKTOP_3=your-sticky-desktop-slot-3-id-here
NEXT_PUBLIC_ADSENSE_SLOT_STICKY_MOBILE=your-sticky-mobile-slot-id-here
# Flip to '1' once the AdSense account itself is approved. The client ID and
# slot IDs above are pre-created and don't change at approval — this is the
# separate switch that actually turns real ads on, so unfilled slots show a
# house ad instead of quietly rendering blank while awaiting review.
NEXT_PUBLIC_ADSENSE_APPROVED=